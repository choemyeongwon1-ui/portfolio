# 이 파일을 복사해서 backend/.env 로 저장한 뒤 값을 채우세요.
# .env 는 git에 올라가지 않습니다.

# 실행 모드: development | production
NODE_ENV=development

# 서버 포트
PORT=4000

# 데이터를 어디서 읽을지: json | db
# json = backend/src/data/*.json 파일 (기본값)
# db   = 데이터베이스 (backend/src/repositories/db 구현 필요)
DATA_SOURCE=json

# DB를 붙일 때만 채우면 됩니다.
DATABASE_URL=
DATABASE_NAME=portfolio

# API 호출을 허용할 프론트엔드 주소. 쉼표로 여러 개, * 면 전부 허용
CORS_ORIGINS=*

# 백엔드가 프론트엔드 정적 파일도 함께 제공할지 여부
# 프론트엔드를 따로 배포하면 false 로 바꾸세요.
SERVE_FRONTEND=true

# ---- 관리자 페이지 ----
# 비밀번호는 해시로 저장합니다. 터미널에서 아래 명령을 실행하면 자동으로 채워집니다.
#   npm run set-password
ADMIN_PASSWORD_HASH=

# 로그인 유지 시간 (분)
ADMIN_SESSION_MINUTES=120
